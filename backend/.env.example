# Copiar a backend/.env y completar. backend/.env NO se commitea.
DB_USER=ADMIN
DB_PASSWORD=
DB_CONNECT_STRING=tallerbasedatos2_high
JWT_SECRET=

# Ruta local a la carpeta wallet/ descargada desde Oracle Cloud.
# El wallet no vive en el repo: se descarga desde la consola de Oracle Cloud.
TNS_ADMIN=/ruta/local/a/Level-UP/wallet
ORACLE_CLIENT_LIB=/ruta/local/a/instantclient

PORT=8080
